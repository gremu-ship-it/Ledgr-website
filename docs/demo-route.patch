@@ -0,0 +1,153 @@
+// @vitest-environment jsdom
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { render, screen, waitFor } from '@testing-library/react';
+import { MemoryRouter, Routes, Route } from 'react-router';
+
+/**
+ * /demo is the marketing site's primary "try before you buy" path, so the
+ * failure modes matter more than the happy path:
+ *
+ *  - it must never sign a REAL user out of their own account,
+ *  - it must never leave a visitor staring at a spinner with no explanation,
+ *  - and it must refuse to pretend it works when it isn't configured.
+ */
+
+const getSessionMock = vi.fn();
+const signInMock = vi.fn();
+const signOutMock = vi.fn();
+
+vi.mock('@/lib/supabase', () => ({
+  supabase: {
+    auth: {
+      getSession: (...args: unknown[]) => getSessionMock(...args),
+      signInWithPassword: (...args: unknown[]) => signInMock(...args),
+      signOut: (...args: unknown[]) => signOutMock(...args),
+    },
+  },
+}));
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (_key: string, fallback?: string) => fallback ?? _key,
+  }),
+}));
+
+vi.mock('@/partner/PartnerContext', () => ({ usePartner: () => ({ partner: null }) }));
+vi.mock('@/partner/usePartnerTheme', () => ({
+  usePartnerTheme: () => ({
+    appName: 'Ledgr',
+    primaryColour: '#1d9e75',
+    logoUrl: null,
+    supportEmail: null,
+  }),
+}));
+
+const DEMO_EMAIL = 'demo@ledgr.test';
+const DEMO_PASSWORD = 'gremu@1989';
+
+async function renderDemo() {
+  const { DemoPage } = await import('../DemoPage');
+  return render(
+    <MemoryRouter initialEntries={['/demo']}>
+      <Routes>
+        <Route path="/demo" element={<DemoPage />} />
+        <Route path="/dashboard" element={<h1>Dashboard</h1>} />
+        <Route path="/register" element={<h1>Register</h1>} />
+      </Routes>
+    </MemoryRouter>,
+  );
+}
+
+beforeEach(() => {
+  vi.resetModules();
+  vi.stubEnv('VITE_DEMO_EMAIL', DEMO_EMAIL);
+  vi.stubEnv('VITE_DEMO_PASSWORD', DEMO_PASSWORD);
+  getSessionMock.mockReset();
+  signInMock.mockReset();
+  signOutMock.mockReset();
+});
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+});
+
+describe('DemoPage', () => {
+  it('signs in with the demo credentials and lands on the dashboard', async () => {
+    getSessionMock.mockResolvedValue({ data: { session: null } });
+    signInMock.mockResolvedValue({
+      data: { session: { user: { email: DEMO_EMAIL } } },
+      error: null,
+    });
+
+    await renderDemo();
+
+    await waitFor(() => expect(screen.getByText('Dashboard')).toBeTruthy());
+    expect(signInMock).toHaveBeenCalledWith({
+      email: DEMO_EMAIL,
+      password: DEMO_PASSWORD,
+    });
+  });
+
+  it('goes straight through when the session is already the demo user', async () => {
+    getSessionMock.mockResolvedValue({
+      data: { session: { user: { email: DEMO_EMAIL } } },
+    });
+
+    await renderDemo();
+
+    await waitFor(() => expect(screen.getByText('Dashboard')).toBeTruthy());
+    expect(signInMock).not.toHaveBeenCalled();
+  });
+
+  it('never silently switches a real user into the demo account', async () => {
+    getSessionMock.mockResolvedValue({
+      data: { session: { user: { email: 'owner@realbusiness.mw' } } },
+    });
+
+    await renderDemo();
+
+    // Offers an explicit choice instead of hijacking the session.
+    await waitFor(() =>
+      expect(screen.getByText('Sign out and open the demo')).toBeTruthy(),
+    );
+    expect(signInMock).not.toHaveBeenCalled();
+    expect(signOutMock).not.toHaveBeenCalled();
+  });
+
+  it('explains an unconfirmed demo account rather than hanging', async () => {
+    getSessionMock.mockResolvedValue({ data: { session: null } });
+    signInMock.mockResolvedValue({
+      data: { session: null },
+      error: { code: 'email_not_confirmed', status: 400, message: 'Email not confirmed' },
+    });
+
+    await renderDemo();
+
+    await waitFor(() =>
+      expect(screen.getByText(/has not been confirmed/i)).toBeTruthy(),
+    );
+  });
+
+  it('treats a missing session without an error as MFA and says so', async () => {
+    getSessionMock.mockResolvedValue({ data: { session: null } });
+    signInMock.mockResolvedValue({ data: { session: null }, error: null });
+
+    await renderDemo();
+
+    await waitFor(() =>
+      expect(screen.getByText(/verification code/i)).toBeTruthy(),
+    );
+  });
+
+  it('flags a misconfigured deployment instead of pretending to work', async () => {
+    vi.stubEnv('VITE_DEMO_EMAIL', '');
+    vi.stubEnv('VITE_DEMO_PASSWORD', '');
+
+    await renderDemo();
+
+    await waitFor(() =>
+      expect(screen.getByText(/not switched on for this deployment/i)).toBeTruthy(),
+    );
+    expect(signInMock).not.toHaveBeenCalled();
+  });
+});
