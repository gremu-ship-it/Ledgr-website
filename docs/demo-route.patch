+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { useAppStore } from '@/store/useAppStore';
+import { isDemoUser } from '@/lib/demo';
+
+/**
+ * Reminds anyone exploring the shared demo business that the figures are
+ * samples, and gives them the one action that matters: create their own
+ * account. Renders nothing at all for normal users.
+ */
+export function DemoModeBanner() {
+  const { t } = useTranslation();
+  const email = useAppStore((s) => s.currentUser?.email);
+  const [dismissed, setDismissed] = useState(false);
+
+  if (dismissed || !isDemoUser(email)) return null;
+
+  return (
+    <div
+      role="status"
+      className="flex flex-wrap items-center justify-between gap-3 border-b border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-900 sm:px-6"
+    >
+      <p className="min-w-0">
+        <span aria-hidden="true">👋</span>{' '}
+        {t(
+          'demo.bannerText',
+          'You are exploring a demo business with sample data. Feel free to click around.',
+        )}
+      </p>
+      <div className="flex items-center gap-3">
+        <a
+          href="/register"
+          className="whitespace-nowrap rounded-lg bg-amber-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-amber-800"
+        >
+          {t('demo.bannerCta', 'Create your own account')}
+        </a>
+        <button
+          type="button"
+          onClick={() => setDismissed(true)}
+          aria-label={t('demo.bannerDismiss', 'Dismiss demo notice')}
+          className="rounded p-1 text-amber-800 transition hover:bg-amber-100"
+        >
+          <span aria-hidden="true">✕</span>
+        </button>
+      </div>
+    </div>
+  );
+}
