index 0000000..3bc1f87
--- /dev/null
+++ b/src/lib/demo.ts
@@ -0,0 +1,35 @@
+/**
+ * Public demo account configuration for the /demo route.
+ *
+ * These values are compiled into the public bundle, which is intentional:
+ * /demo signs visitors in automatically so they never have to type
+ * credentials. That is only safe because of two hard rules:
+ *
+ *   1. The account must contain SAMPLE DATA ONLY. Everything it can see is
+ *      effectively public, because anyone can read these credentials out of
+ *      the bundle or the network tab.
+ *   2. The account must NEVER hold elevated privileges — no platform admin,
+ *      no partner admin, and no membership of a real business. Keep it a
+ *      throwaway sample business that owns nothing else.
+ *
+ * Both values must be set for /demo to work; if either is missing the page
+ * explains how to enable it instead of half-working. See DEMO.md in the
+ * Ledgr-website repo for the checklist.
+ */
+
+const email = (import.meta.env.VITE_DEMO_EMAIL ?? '').trim();
+const password = (import.meta.env.VITE_DEMO_PASSWORD ?? '').trim();
+
+export const demoCredentials = { email, password } as const;
+
+/** True when /demo has both credentials it needs. */
+export const isDemoConfigured = Boolean(email && password);
+
+/**
+ * Is this the shared demo account? Used to show the demo banner inside the
+ * app and to avoid clobbering a real user's session on /demo.
+ */
+export function isDemoUser(userEmail: string | null | undefined): boolean {
+  if (!isDemoConfigured || !userEmail) return false;
+  return userEmail.trim().toLowerCase() === email.toLowerCase();
+}
diff --git a/src/pages/DemoPage.tsx b/src/pages/DemoPage.tsx
new file mode 100644
index 0000000..b42fa92
--- /dev/null
+++ b/src/pages/DemoPage.tsx
@@ -0,0 +1,209 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { Link, useNavigate } from 'react-router';
+import { useTranslation } from 'react-i18next';
+import { supabase } from '@/lib/supabase';
+import { createLogger } from '@/lib/logger';
+import { demoCredentials, isDemoConfigured } from '@/lib/demo';
+import { AuthShell } from '@/components/auth/AuthShell';
+import { AuthAlert } from '@/components/auth/AuthUI';
+import { LoadingSpinner } from '@/components/LoadingSpinner';
+
+const log = createLogger('DemoPage');
+
+type Status =
+  | { kind: 'working' }
+  | { kind: 'prompt' }        // someone else is already signed in
+  | { kind: 'error'; message: string }
+  | { kind: 'not-configured' };
+
+/**
+ * Public demo entry point. The marketing site links here (NEXT_PUBLIC_DEMO_URL)
+ * so a visitor lands inside a real, populated business without typing anything.
+ *
+ * It deliberately does NOT live behind PublicOnlyRoute: a signed-in user who
+ * opens /demo should be told who they are signed in as, not silently bounced or
+ * silently switched to another account.
+ */
+export function DemoPage() {
+  const { t } = useTranslation();
+  const navigate = useNavigate();
+  const [status, setStatus] = useState<Status>({ kind: 'working' });
+  // Guards against React 18/19 StrictMode double-invocation in dev firing two
+  // sign-ins, and against a click racing the initial check.
+  const startedRef = useRef(false);
+
+  const goToDashboard = useCallback(() => {
+    // replace: visitors should not be able to hit "back" into the demo
+    // splash and get re-signed-in in a loop.
+    navigate('/dashboard', { replace: true });
+  }, [navigate]);
+
+  const signIn = useCallback(async () => {
+    setStatus({ kind: 'working' });
+
+    const { data, error } = await supabase.auth.signInWithPassword({
+      email: demoCredentials.email,
+      password: demoCredentials.password,
+    });
+
+    if (error) {
+      log.warn('Demo sign-in failed', { code: error.code, status: error.status });
+      // Supabase reports a bad password, a non-existent user and an
+      // unconfirmed email as different things — say which one it is, because
+      // only one of them is fixable by the visitor.
+      if (error.code === 'email_not_confirmed') {
+        setStatus({
+          kind: 'error',
+          message: t(
+            'demo.errorUnconfirmed',
+            'The demo account has not been confirmed yet. Please tell us via the website contact form and we will fix it.',
+          ),
+        });
+        return;
+      }
+      if (error.code === 'invalid_credentials') {
+        setStatus({
+          kind: 'error',
+          message: t(
+            'demo.errorCredentials',
+            'The demo sign-in details are out of date. Please tell us via the website contact form and we will fix it.',
+          ),
+        });
+        return;
+      }
+      setStatus({
+        kind: 'error',
+        message: t(
+          'demo.errorService',
+          'We could not reach the demo right now. Please try again, or create a free account instead.',
+        ),
+      });
+      return;
+    }
+
+    // No error but no session means a second factor is required. The demo
+    // account must have MFA switched off, or nobody can get in.
+    if (!data.session) {
+      setStatus({
+        kind: 'error',
+        message: t(
+          'demo.errorMfa',
+          'This demo account is asking for a verification code. Please tell us via the website contact form and we will fix it.',
+        ),
+      });
+      return;
+    }
+
+    goToDashboard();
+  }, [goToDashboard, t]);
+
+  // On mount: an existing session wins. Never sign a real user out of their own
+  // account to show them a demo — that would lose their unsaved work.
+  useEffect(() => {
+    if (startedRef.current) return;
+    startedRef.current = true;
+
+    async function start() {
+      if (!isDemoConfigured) {
+        setStatus({ kind: 'not-configured' });
+        return;
+      }
+
+      const { data } = await supabase.auth.getSession();
+      const existingEmail = data.session?.user?.email ?? null;
+
+      if (data.session) {
+        if (existingEmail && existingEmail.toLowerCase() === demoCredentials.email.toLowerCase()) {
+          goToDashboard();
+          return;
+        }
+        setStatus({ kind: 'prompt' });
+        return;
+      }
+
+      await signIn();
+    }
+
+    void start();
+  }, [goToDashboard, signIn]);
+
+  return (
+    <AuthShell title={t('demo.title', 'Opening the Ledgr demo…')}>
+      {status.kind === 'working' && (
+        <div className="flex flex-col items-center gap-3 py-2">
+          <LoadingSpinner label={t('demo.signingIn', 'Signing you into a sample business…')} />
+          <p className="text-center text-sm text-gray-500">
+            {t('demo.noAccount', 'No account needed, and nothing to install.')}
+          </p>
+        </div>
+      )}
+
+      {status.kind === 'not-configured' && (
+        <AuthAlert
+          type="error"
+          message={t(
+            'demo.notConfigured',
+            'The demo is not switched on for this deployment. Set VITE_DEMO_EMAIL and VITE_DEMO_PASSWORD, then redeploy.',
+          )}
+        />
+      )}
+
+      {status.kind === 'prompt' && (
+        <div className="space-y-4">
+          <AuthAlert
+            type="info"
+            message={t(
+              'demo.alreadySignedIn',
+              'You are already signed in to Ledgr on this device.',
+            )}
+          />
+          <p className="text-sm text-gray-600">
+            {t(
+              'demo.alreadySignedInBody',
+              'Opening the demo would sign you out of your own account, so we have stopped here. Use a private window to explore the demo without losing your session.',
+            )}
+          </p>
+          <div className="flex flex-col gap-2">
+            <button
+              type="button"
+              onClick={() => {
+                void supabase.auth.signOut().then(() => signIn());
+              }}
+              className="w-full rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-800"
+            >
+              {t('demo.signOutAndContinue', 'Sign out and open the demo')}
+            </button>
+            <button
+              type="button"
+              onClick={goToDashboard}
+              className="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-700 transition hover:border-gray-300"
+            >
+              {t('demo.backToMyAccount', 'Take me back to my account')}
+            </button>
+          </div>
+        </div>
+      )}
+
+      {status.kind === 'error' && (
+        <div className="space-y-4">
+          <AuthAlert type="error" message={status.message} />
+          <div className="flex flex-col gap-2">
+            <button
+              type="button"
+              onClick={() => void signIn()}
+              className="w-full rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-800"
+            >
+              {t('demo.retry', 'Try again')}
+            </button>
+            <Link
+              to="/register"
+              className="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-center text-sm font-semibold text-gray-700 transition hover:border-gray-300"
+            >
+              {t('demo.createAccount', 'Create a free account instead')}
+            </Link>
+          </div>
+        </div>
+      )}
+    </AuthShell>
+  );
+}
diff --git a/src/pages/__tests__/DemoPage.test.tsx b/src/pages/__tests__/DemoPage.test.tsx
