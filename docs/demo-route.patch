+
+/**
+ * Optional public demo account used by the /demo route. Both must be set for
+ * the route to work. See src/lib/demo.ts for why these are public by design.
+ */
+interface ImportMetaEnv {
+  readonly VITE_DEMO_EMAIL?: string;
+  readonly VITE_DEMO_PASSWORD?: string;
+}
