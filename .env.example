# ---- Required for backend features (waitlist, contact, newsletter) ----
# Get a free Postgres DB from Neon (https://neon.tech) or Supabase.
# Paste the pooled connection string here and in Vercel env vars.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---- Site ----
# Public base URL of the deployed marketing site (used for sitemap/OG tags)
NEXT_PUBLIC_SITE_URL=https://ledgr.mw
# Public contact email shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=gremu.consultancy@gmail.com

# ---- WhatsApp (direct enquiries) ----
# Defaults to +265 881 444 487 (contact page, footer, sticky CTA).
# Override the displayed number if it ever changes:
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Or override the footer link entirely:
NEXT_PUBLIC_WHATSAPP_URL=

# ---- Social links (optional — footer only shows the ones you set) ----
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ---- Public demo account (optional) ----
# Adds a "Try the live demo" button on the homepage hero and product tour, and
# shows the demo login details. Set the email + password and the button goes to
# the app login page; leave both blank until the demo user actually exists — the
# "try it" buttons then point at free registration instead, so the site can never
# promise a demo that fails to load. See DEMO.md.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
# Only needed for a one-click demo route (takes priority over the login page).
NEXT_PUBLIC_DEMO_URL=

# ---- Analytics (optional, privacy-friendly Plausible) ----
# Set the domain to enable, e.g. NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ledgr.mw
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
