# ---- Required for backend features (waitlist, contact, newsletter) ----
# Get a free Postgres DB from Neon (https://neon.tech) or Supabase.
# Paste the pooled connection string here and in Vercel env vars.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---- Site ----
# Public base URL of the deployed marketing site (used for sitemap/OG tags)
NEXT_PUBLIC_SITE_URL=https://ledgr.mw
# Public contact email shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=gremu.consultancy@gmail.com

# ---- WhatsApp (direct enquiries) ----
# Defaults to +265 881 444 487 (contact page, footer, sticky CTA).
# Override the displayed number if it ever changes:
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Or override the footer link entirely:
NEXT_PUBLIC_WHATSAPP_URL=

# ---- Social links (optional — footer only shows the ones you set) ----
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ---- The app (optional, recommended) ----
# One origin drives every link that leaves this site: the demo, register, login
# and the dashboard. Defaults to the app's current domain; set it when the app
# moves to a custom one, e.g. NEXT_PUBLIC_APP_URL=https://app.ledgr.com — one
# variable moves all four links, including the demo.
NEXT_PUBLIC_APP_URL=

# ---- Public demo (optional overrides) ----
# The demo is one-click and passwordless: <app>/demo/enter seeds a sample
# business into the visitor's own browser, signs them in as the sample owner and
# lands them on the dashboard; <app>/demo is a static, read-only 1-minute tour.
# Both are derived from NEXT_PUBLIC_APP_URL above — there is no password to set.
# To remove every demo call to action without a code change, redeploy with
# NEXT_PUBLIC_DEMO_ENABLED=false — the site falls back to free registration and
# shows no demo copy at all. See DEMO.md.
NEXT_PUBLIC_DEMO_ENABLED=true
# Only labels the demo identity in the copy (the app owns the demo login).
NEXT_PUBLIC_DEMO_EMAIL=
# Point the demo CTAs at a different route if the demo ever moves.
NEXT_PUBLIC_DEMO_URL=

# ---- Analytics (optional, privacy-friendly Plausible) ----
# Set the domain to enable, e.g. NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ledgr.mw
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
